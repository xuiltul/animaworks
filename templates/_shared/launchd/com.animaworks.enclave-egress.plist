<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Root LaunchDaemon that loads the enclave pf rules at boot and refreshes them
  hourly (AWS ranges and the allow-hosts addresses move).  Copy
  scripts/enclave/egress_firewall.py to a root-owned path the enclave and host
  users cannot write (here /usr/local/libexec), adjust the arguments, then:
    install -m 0644 -o root -g wheel com.animaworks.enclave-egress.plist /Library/LaunchDaemons/
    launchctl bootstrap system /Library/LaunchDaemons/com.animaworks.enclave-egress.plist
-->
<plist version="1.0">
<dict>
	<key>Label</key>
	<string>com.animaworks.enclave-egress</string>
	<key>ProgramArguments</key>
	<array>
		<string>/usr/bin/python3</string>
		<string>/usr/local/libexec/animaworks-enclave-egress.py</string>
		<string>--backend</string>
		<string>pf</string>
		<string>--user</string>
		<string>_awenclave</string>
		<string>--region</string>
		<string>ap-northeast-1</string>
		<string>--loopback-ports</string>
		<string>18610,33061-33070</string>
		<string>--apply</string>
	</array>
	<key>RunAtLoad</key>
	<true/>
	<key>StartInterval</key>
	<integer>3600</integer>
	<key>StandardOutPath</key>
	<string>/var/log/animaworks-enclave-egress.log</string>
	<key>StandardErrorPath</key>
	<string>/var/log/animaworks-enclave-egress.log</string>
</dict>
</plist>
